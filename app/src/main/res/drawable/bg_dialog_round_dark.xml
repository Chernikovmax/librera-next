<?xml version="1.0" encoding="utf-8"?>
<!-- The same sheet for a dark theme: the floating surface Material uses, held a little short
     of opaque and cut to the same round. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle" >

    <solid android:color="?attr/appSurface" />

    <stroke android:width="1dp" android:color="?attr/appOutline" />

    <corners android:radius="@dimen/radius" />
</shape>
