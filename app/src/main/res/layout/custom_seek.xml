<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fontSizeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:gravity="center_vertical"
        android:labelFor="@id/seek" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:singleLine="true"
        android:gravity="center"
        android:paddingHorizontal="4dp"
        android:text="0" />

    <SeekBar
        android:id="@+id/seek"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:saveEnabled="false" />

    <ImageView
        android:id="@+id/minus"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:background="@drawable/redesign_toolbar_button"
        android:contentDescription="@string/minus"
        android:src="@drawable/glyphicons_372_minus"
        android:tint="?attr/appOnSurface" />

    <ImageView
        android:contentDescription="@string/plus"
        android:id="@+id/plus"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:background="@drawable/redesign_toolbar_button"
        android:src="@drawable/glyphicons_371_plus"
        android:tint="?attr/appOnSurface" />

    </LinearLayout>
</LinearLayout>