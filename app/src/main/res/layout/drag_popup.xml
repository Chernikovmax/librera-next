<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_view"
    android:layout_width="300dip"
    android:layout_height="wrap_content"
    android:layout_margin="2dip"
    android:background="?android:attr/colorBackground"
    android:elevation="4dp"
    card_view:cardCornerRadius="@dimen/radius"
    card_view:cardUseCompatPadding="true" >

    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" >

        <RelativeLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="?attr/appSurface">

            <TextView
                android:id="@+id/onTitleAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/redesign_toolbar_button"
                android:focusable="true"
                android:text="@string/preferences"
                android:textColor="?attr/appPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/onTitleAction"
                android:layout_marginEnd="96dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:textColor="?attr/appOnSurface"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/onIconAction"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/dialogTitle"
                android:layout_marginEnd="48dp"
                android:padding="12dp"
                android:background="@drawable/redesign_toolbar_button"
                android:focusable="true"
                android:contentDescription="@string/menu"
                android:src="@drawable/my_glyphicons_114_paragraph_justify" />

            <ImageView
                android:id="@+id/closePopup"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:padding="12dp"
                android:background="@drawable/redesign_toolbar_button"
                android:focusable="true"
                android:contentDescription="@string/close_dialog_and_apply_changes"
                android:src="@drawable/glyphicons_599_menu_close" />
        </RelativeLayout>

        <com.foobnix.pdf.info.view.MyFrameLayout
            android:id="@+id/popupContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/topLayout"
            android:layout_centerHorizontal="true"
            android:clickable="true" >
        </com.foobnix.pdf.info.view.MyFrameLayout>

        <View
            android:id="@+id/left"
            android:layout_width="25dip"
            android:layout_height="25dip"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:layout_weight="0"
            android:background="@drawable/bg_triangle_left" >
        </View>

        <View
            android:id="@+id/rigth"
            android:layout_width="25dip"
            android:layout_height="25dip"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_weight="0"
            android:background="@drawable/bg_triangle_right" >
        </View>
    </RelativeLayout>

</androidx.cardview.widget.CardView>