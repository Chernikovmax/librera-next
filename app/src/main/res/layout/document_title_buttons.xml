<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="?attr/appSurface"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="54dp"
            android:layout_marginEnd="54dp"
            android:fillViewport="true"
            android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="2dip"
            android:paddingRight="2dip"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            >

            <ImageView
                android:id="@+id/goToPage1"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/reader_first_page"
                android:src="@drawable/glyphicons_172_skip_to_start" />

            <ImageView
                android:id="@+id/moveLeft"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/left"
                android:src="@drawable/glyphicons_309_square_empty_left" />

            <ImageView
                android:id="@+id/moveCenter"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/db_auto_center_horizontally"
                android:src="@drawable/glyphicons_112_paragraph_center" />

            <ImageView
                android:id="@+id/moveRight"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/right"
                android:src="@drawable/glyphicons_310_square_empty_right" />

            <ImageView
                android:id="@+id/zoomMinus"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/reader_zoom_out"
                android:src="@drawable/glyphicons_632_circle_minus" />

            <ImageView
                android:id="@+id/zoomPlus"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/reader_zoom_in"
                android:src="@drawable/glyphicons_631_circle_plus" />

            <com.foobnix.pdf.info.view.UnderlineImageView
                android:id="@+id/onBC"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/contrast"
                android:src="@drawable/glyphicons_92_contrast" />

            <ImageView
                android:id="@+id/brightness"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/day"
                android:src="@drawable/glyphicons_232_sun" />

            <com.foobnix.pdf.info.view.UnderlineImageView
                android:id="@+id/crop"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/crop_white_borders"
                android:src="@drawable/glyphicons_94_crop" />

            <com.foobnix.pdf.info.view.UnderlineImageView
                android:id="@+id/cut"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/split_pages_in_two"
                android:src="@drawable/my_glyphicons_page_split"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/fullscreen"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/full_screen"
                android:src="@drawable/glyphicons_216_fullscreen" />

            <ImageView
                android:id="@+id/onTextReplacement"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/replacements"
                android:src="@drawable/my_glyphicons_pen" />

            <ImageView
                android:id="@+id/prefTop"
                style="@style/buttonWhite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:contentDescription="@string/preferences"
                android:src="@drawable/glyphicons_137_cogwheel" />
        </LinearLayout>
        </HorizontalScrollView>

        <!-- The way back to the library, set in the corner opposite the one that closes the
             book and ringed the same way, so the two read as a pair. -->
        <ImageView
            android:id="@+id/onLibrary"
            style="@style/buttonWhiteClose"
            android:background="@drawable/bg_round_button"
            android:padding="7dip"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_gravity="left"
            android:layout_marginLeft="2dip"
            android:layout_weight="0"
            android:contentDescription="@string/library"
            android:src="@drawable/glyphicons_589_book_open" />

        <ImageView
            android:id="@+id/close"
            style="@style/buttonWhiteClose"
            android:background="@drawable/bg_round_button"
            android:padding="7dip"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_gravity="right"
            android:layout_marginRight="2dip"
            android:layout_weight="0"
            android:contentDescription="@string/close"
            android:src="@drawable/glyphicons_599_menu_close" />

    </RelativeLayout>




    <include
        android:id="@+id/showHypenLangPanel"
        layout="@layout/layout_hypen_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="visible" />

    <TextView
        android:background="#F44336"
        android:visibility="gone"
        android:id="@+id/onSaveAnnotation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:padding="8dp"
        android:gravity="center"
        android:maxLines="3"
        android:layout_weight="0"
        android:textColor="@color/white"
        android:text="@string/warning_this_document_has_unsaved_changes" />


</LinearLayout>