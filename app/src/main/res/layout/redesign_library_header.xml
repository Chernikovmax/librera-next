<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/library_home_title" android:textSize="28sp" android:textStyle="bold" android:textColor="?attr/appOnSurface" />
    <TextView android:id="@+id/librarySummary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="?attr/appOnSurfaceVariant" />
    <LinearLayout android:id="@+id/libraryContinueSection" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" android:text="@string/library_continue_label" android:textSize="11sp"
            android:letterSpacing="0.12" android:textStyle="bold" android:textColor="?attr/appOnSurfaceVariant" />
        <LinearLayout android:id="@+id/libraryContinueCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/libraryContinueCover" android:layout_width="94dp" android:layout_height="137dp"
                android:importantForAccessibility="no" android:scaleType="fitCenter" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:id="@+id/libraryContinueAuthor" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textColor="?attr/appPrimary" />
                <TextView android:id="@+id/libraryContinueTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:textSize="17sp" android:textStyle="bold" android:maxLines="2"
                    android:ellipsize="end" android:textColor="?attr/appOnSurface" />
                <TextView android:id="@+id/libraryContinueProgress" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textSize="11sp" android:textColor="?attr/appOnSurfaceVariant" />
                <View android:id="@+id/libraryContinueProgressBar" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/libraryContinueButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:minWidth="48dp" android:layout_marginTop="8dp"
                    android:paddingStart="13dp" android:paddingEnd="13dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center"
                    android:clickable="true" android:focusable="true" android:text="@string/library_continue_action"
                    android:textSize="12sp" android:textStyle="bold" android:textColor="?attr/appOnPrimary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/library_shelf_title" android:textSize="19sp" android:textStyle="bold" android:textColor="?attr/appOnSurface" />
        <ImageView android:id="@+id/onGridList" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="13dp" android:contentDescription="@string/cd_view_menu" android:tint="?attr/appOnSurfaceVariant"
            android:background="@drawable/redesign_toolbar_button" android:src="@drawable/my_glyphicons_114_paragraph_justify" />
        <ImageView android:id="@+id/libraryShelfSort" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="13dp" android:contentDescription="@string/cd_sort_results" android:tint="?attr/appOnSurfaceVariant"
            android:background="@drawable/redesign_toolbar_button" android:src="@drawable/glyphicons_476_sort_attributes" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/libraryFilterAll" style="@style/Widget.Librera.LibraryChip" android:text="@string/library_filter_all" />
            <TextView android:id="@+id/libraryFilterReading" style="@style/Widget.Librera.LibraryChip" android:text="@string/library_filter_reading" />
            <TextView android:id="@+id/libraryFilterFinished" style="@style/Widget.Librera.LibraryChip" android:text="@string/library_filter_finished" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView android:id="@+id/libraryNoResults" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="24dp" android:paddingBottom="24dp" android:text="@string/library_no_results"
        android:textColor="?attr/appOnSurfaceVariant" android:textSize="14sp" android:visibility="gone" />
</LinearLayout>
