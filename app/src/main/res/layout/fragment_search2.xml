<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/filterLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dip"
        android:paddingBottom="6dip">

        <ImageView android:id="@+id/menu2" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="13dp" android:contentDescription="@string/cd_application_menu"
            android:background="@drawable/redesign_toolbar_button" android:src="@drawable/glyphicons_600_menu" />
        <TextView android:id="@+id/libraryBrand" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:gravity="center_vertical" android:text="Librera"
            android:textSize="20sp" android:textStyle="bold" android:textColor="?attr/appOnSurface" />
        <RelativeLayout android:id="@+id/librarySearchBox" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:visibility="gone">
            <AutoCompleteTextView android:id="@+id/filterLine" android:layout_width="match_parent"
                android:layout_height="match_parent" android:contentDescription="@string/filter"
                android:hint="@string/library" android:singleLine="true" android:inputType="text"
                android:paddingEnd="48dp" android:textSize="14sp" android:background="@null"
                android:textColor="?attr/appOnSurface" android:textColorHint="?attr/appOnSurfaceVariant" />
            <TextView android:id="@+id/countBooks" android:layout_width="0dp" android:layout_height="0dp" android:text="0" />
            <ImageView android:id="@+id/myAutoCompleteImage" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_alignParentEnd="true" android:padding="14dp" android:visibility="gone"
                android:contentDescription="@string/search_history_and_autocomplete" android:src="@drawable/glyphicons_739_check" />
            <ImageView android:id="@+id/cleanFilter" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_alignParentEnd="true" android:padding="14dp"
                android:contentDescription="@string/cd_clear_search_reasult" android:src="@drawable/glyphicons_599_menu_close" />
        </RelativeLayout>
        <ImageView android:id="@+id/librarySearchToggle" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="13dp" android:contentDescription="@string/search" android:tint="?attr/appOnSurface"
            android:background="@drawable/redesign_toolbar_button" android:src="@drawable/glyphicons_28_search" />
        <LinearLayout android:id="@+id/secondTopPanel" android:layout_width="wrap_content" android:layout_height="48dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/sortBy" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="13dp" android:contentDescription="@string/cd_sort_results"
                android:background="@drawable/redesign_toolbar_button" android:src="@drawable/glyphicons_476_sort_attributes" />
            <ImageView android:id="@+id/sortOrder" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="13dp" android:visibility="gone" android:contentDescription="@string/cd_sort_order"
                android:src="@drawable/glyphicons_221_chevron_down" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/panel_on_grant" />

    <LinearLayout
        android:id="@+id/layoutError"
        android:background="@color/green_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dip"
        android:gravity="center_vertical"
        >

        <TextView
            android:id="@+id/hypenLangLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dip"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:text="@string/search_error_msg1" />

        <!-- The answer to the notice, drawn as the notice above it draws its own: a ring
             around the word rather than an underlined one. -->
        <TextView
            android:id="@+id/layoutErrorOnRestart"
            style="@style/textLinkWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dip"
            android:layout_marginRight="6dip"
            android:layout_weight="0"
            android:gravity="center"
            android:background="@drawable/bg_pill_outline"
            android:paddingLeft="16dip"
            android:paddingRight="16dip"
            android:paddingTop="5dip"
            android:paddingBottom="5dip"
            android:textAllCaps="true"
            android:text="@string/search" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.foobnix.ui2.fast.FastScrollRecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:bubbleColor="#00bb00"
            app:bubbleTextColor="#ffffff"
            app:handleColor="#999999"
            app:hideScrollbar="true"
            app:showTrack="false"
            app:trackColor="#bbbbbb"></com.foobnix.ui2.fast.FastScrollRecyclerView>
            <LinearLayout
                android:id="@+id/emptyLibraryState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dip"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/empty_library_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dip"
                    android:gravity="center"
                    android:text="@string/empty_library_message"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/emptyLibraryAddFolder"
                    style="@style/textLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dip"
                    android:background="@drawable/bg_pill_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="20dip"
                    android:paddingTop="10dip"
                    android:paddingRight="20dip"
                    android:paddingBottom="10dip"
                    android:text="@string/add_folder" />

                <TextView
                    android:id="@+id/emptyLibraryRescan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dip"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dip"
                    android:text="@string/update_library"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
    </FrameLayout>

</LinearLayout>